# Copy to .env.local for `npm run dev` (values are baked in at build time).
# On Cloud Run, set the same names WITHOUT the VITE_ prefix as service env vars
# (GOOGLE_OAUTH_CLIENT_ID, GCS_BUCKET, GCS_OBJECT_PREFIX) — read at container
# startup, no rebuild needed.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GCS_BUCKET=
# Optional folder inside the bucket, e.g. flows/ — leave blank for bucket root.
VITE_GCS_OBJECT_PREFIX=
